# Copy to .env and fill in from your Supabase project (Settings > API keys).
# Read by the app in the browser:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Read only by `npm run seed`. Never prefix with VITE_, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
