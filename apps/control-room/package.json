{
  "name": "@bahn/control-room",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "screens": "tsx scripts/screens.ts",
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "check:db": "tsx --env-file=.env scripts/check-db.ts"
  },
  "dependencies": {
    "@bahn/shared": "^0.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
